  "selection_rationale": [
    {
      "decision": "include",
      "id": "resilience",
      "reason": "Every Token Factory and Tavily call must degrade to golden cache, never throw on stage; a triage demo dies on venue Wi-Fi otherwise."
    },
    {
      "decision": "include",
      "id": "platform",
      "reason": "Submission requires a working demo URL live through judging; deploy plus streaming UI carries the ticket-queue demo the brief demands."
    },
    {
      "decision": "exclude",
      "id": "media",
      "reason": "Brief mentions no audio, image, PDF, or voice requirement for the Best Apps track; media wrappers would be dead weight."
    },
    {
      "decision": "include",
      "id": "ideation",
      "reason": "A sub-3-minute judged video with Token Factory, Nemotron and Tavily audio proof needs deckgen, script, demodrive capture, and faqdef."
    },
    {
      "decision": "include",
      "id": "context",
      "reason": "Super classifier inputs span runbook corpora and long ticket threads; the buffer prevents context-length failure mid-demo."
    },
    {
      "decision": "include",
      "id": "dev-tooling",
      "reason": "Classifier taxonomy edits need evals after every change, mock envelopes for offline demo, and track status across the build."
    },
    {
      "decision": "exclude",
      "id": "assembly-advisory",
      "reason": "Already run pre-assembly to produce this proposal; rationale-skipped in the delivered app per catalog guidance."
    },
    {
      "decision": "exclude",
      "id": "data",
      "reason": "The seeded fixture ticket corpus is small enough to ship as checked-in fixtures; no synthetic-data generator needed at assembly time."
    },
    {
      "decision": "include",
      "id": "cost",
      "reason": "Per-ticket token metering against the $50 Builder credits underpins the unit-economics pitch; every call needs guardrails."
    },
    {
      "decision": "include",
      "id": "provenance",
      "reason": "Submission gate requires an OSI license file, README run guidance, and disclosure formatting via prov and submit."
    },
    {
      "decision": "exclude",
      "id": "pgm",
      "reason": "Already run pre-assembly to produce the winning plan; rationale-skipped post-assembly, not part of the delivered app."
    },
    {
      "decision": "exclude",
      "id": "profile",
      "reason": "Profile extraction was skipped for lack of keys and consumers tolerate it; rationale-skipped post-assembly."
    }
  ],
